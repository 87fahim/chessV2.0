# Backend server port
PORT=8787

# MongoDB connection string. Include credentials/host from your Mongo server.
# Example: mongodb://127.0.0.1:27017/ludo
# Example Atlas: mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Optional explicit DB name override. Defaults to "ludo".
MONGODB_DB=ludo
